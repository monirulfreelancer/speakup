// SpeakUp — database schema
//
// Models are PascalCase, tables and columns snake_case via @@map/@map.
// Later-phase models (PracticeSession, SessionTurn, LanguageViolation,
// UserStats, Event) are defined NOW so later phases only add fields, never
// restructure.
//
// Connection URLs live in prisma.config.ts — that moved in Prisma 7.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url is configured in prisma.config.ts
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum SessionMode {
  AI
  HUMAN
}

enum SpeakerRole {
  USER
  AI
  PARTNER
}

enum EnforcementMode {
  GENTLE
  STRICT
  AUTO
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum ConsentType {
  SPEECH_PROCESSING
  TRANSCRIPT_STORAGE
  HUMAN_CALL
}

// ---------------------------------------------------------------------------
// Identity and profile
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  photoUrl     String?   @map("photo_url")

  // Filled during onboarding, so nullable until then. `onboardedAt` being
  // set is the signal that the wizard was completed.
  nativeLanguage String?    @map("native_language")
  cefrLevel      CefrLevel? @map("cefr_level")
  dateOfBirth    DateTime?  @map("date_of_birth") @db.Date
  isAdult        Boolean    @default(false) @map("is_adult")

  // Directory profile. Interests come from the fixed list in
  // src/lib/interests.ts; storing free text here would make the chips
  // meaningless for filtering later.
  bio        String?  @db.VarChar(200)
  interests  String[] @default([])
  lastSeenAt DateTime? @map("last_seen_at")
  // Stamped on every avatar change. Lets list queries build the image URL
  // (and its cache-busting ?v=) without joining the bytes.
  avatarUpdatedAt DateTime? @map("avatar_updated_at")

  enforcementMode EnforcementMode @default(AUTO) @map("enforcement_mode")
  role            String          @default("user")
  onboardedAt     DateTime?       @map("onboarded_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  accounts         Account[]
  sessions         Session[]
  settings         UserSettings?
  consents         Consent[]
  practiceSessions PracticeSession[]
  violations       LanguageViolation[]
  stats            UserStats?
  events           Event[]
  avatar           Avatar?

  @@map("users")
}

// Standard Auth.js adapter models. Unused columns (OAuth comes later, if
// ever) still exist so the adapter works unmodified.
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model UserSettings {
  id                   String  @id @default(cuid())
  userId               String  @unique @map("user_id")
  uiLanguage           String  @default("en") @map("ui_language")
  notificationsEnabled Boolean @default(false) @map("notifications_enabled")
  ttsVoice             String? @map("tts_voice")
  ttsRate              Float   @default(1.0) @map("tts_rate")
  autoLevelAdjust      Boolean @default(false) @map("auto_level_adjust")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Consent {
  id        String      @id @default(cuid())
  userId    String      @map("user_id")
  type      ConsentType
  version   String
  grantedAt DateTime    @default(now()) @map("granted_at")
  revokedAt DateTime?   @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("consents")
}

// ---------------------------------------------------------------------------
// Practice content
// ---------------------------------------------------------------------------

model Topic {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String
  icon        String
  minLevel    CefrLevel @map("min_level")
  maxLevel    CefrLevel @map("max_level")
  promptSeed  String    @map("prompt_seed") @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")

  practiceSessions PracticeSession[]

  @@map("topics")
}

model PracticeSession {
  id              String        @id @default(cuid())
  userId          String        @map("user_id")
  mode            SessionMode
  topicId         String?       @map("topic_id")
  matchId         String?       @map("match_id")
  levelAtSession  CefrLevel     @map("level_at_session")
  startedAt       DateTime      @default(now()) @map("started_at")
  endedAt         DateTime?     @map("ended_at")
  durationSeconds Int           @default(0) @map("duration_seconds")
  status          SessionStatus @default(ACTIVE)
  aiProvider      String?       @map("ai_provider")
  aiModel         String?       @map("ai_model")

  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)
  turns SessionTurn[]
  violations LanguageViolation[]

  @@index([userId, startedAt(sort: Desc)])
  @@map("practice_sessions")
}

// The turns ARE the transcript — no separate transcript table.
model SessionTurn {
  id                 String      @id @default(cuid())
  sessionId          String      @map("session_id")
  seq                Int
  speaker            SpeakerRole
  text               String      @db.Text
  detectedLanguage   String?     @map("detected_language")
  languageConfidence Float?      @map("language_confidence")
  sttConfidence      Float?      @map("stt_confidence")
  audioMs            Int?        @map("audio_ms")
  createdAt          DateTime    @default(now()) @map("created_at")

  session    PracticeSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  violations LanguageViolation[]

  @@index([sessionId, seq])
  @@map("session_turns")
}

model LanguageViolation {
  id               String   @id @default(cuid())
  sessionId        String   @map("session_id")
  userId           String   @map("user_id")
  turnId           String?  @map("turn_id")
  detectedLanguage String   @map("detected_language")
  detector         String
  actionTaken      String   @map("action_taken")
  createdAt        DateTime @default(now()) @map("created_at")

  session PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  turn    SessionTurn?    @relation(fields: [turnId], references: [id], onDelete: SetNull)

  @@map("language_violations")
}

// ---------------------------------------------------------------------------
// Engagement
// ---------------------------------------------------------------------------

model UserStats {
  id               String    @id @default(cuid())
  userId           String    @unique @map("user_id")
  totalSeconds     Int       @default(0) @map("total_seconds")
  sessionsCount    Int       @default(0) @map("sessions_count")
  aiSessions       Int       @default(0) @map("ai_sessions")
  humanSessions    Int       @default(0) @map("human_sessions")
  distinctPartners Int       @default(0) @map("distinct_partners")
  currentStreak    Int       @default(0) @map("current_streak")
  longestStreak    Int       @default(0) @map("longest_streak")
  lastPracticeDate DateTime? @map("last_practice_date") @db.Date
  wordsSaved       Int       @default(0) @map("words_saved")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

// The spine for badges (Phase 11): every meaningful action appends an event.
model Event {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt(sort: Desc)])
  @@map("events")
}

// ---------------------------------------------------------------------------
// Human mode: matching queue (Phase 12)
//
// These tables are ALSO read and written by the realtime service (realtime/)
// via plain SQL over `pg`. The web app remains the single owner of the schema
// and all migrations — the service must never migrate. Column renames here
// therefore require a matching change in realtime/src.
// ---------------------------------------------------------------------------

enum QueueStatus {
  WAITING
  MATCHED
  CANCELLED
  EXPIRED
}

model MatchQueue {
  id            String      @id @default(cuid())
  userId        String      @map("user_id")
  level         CefrLevel
  allowedLevels String[]    @map("allowed_levels")
  status        QueueStatus @default(WAITING)
  enqueuedAt    DateTime    @default(now()) @map("enqueued_at")
  expiresAt     DateTime    @map("expires_at")
  matchId       String?     @map("match_id")

  @@index([status, level, enqueuedAt])
  @@map("match_queue")
}

model Match {
  id              String    @id @default(cuid())
  roomId          String    @unique @map("room_id")
  userAId         String    @map("user_a_id")
  userBId         String    @map("user_b_id")
  topicId         String?   @map("topic_id")
  startedAt       DateTime  @default(now()) @map("started_at")
  // Set when the callee accepts. Its absence is what makes "this call was
  // never answered" knowable, which is the basis of the staleness sweep.
  answeredAt      DateTime? @map("answered_at")
  endedAt         DateTime? @map("ended_at")
  endReason       String?   @map("end_reason")
  durationSeconds Int       @default(0) @map("duration_seconds")
  // Which ICE path the call used: host / srflx / relay. Measuring how often
  // TURN actually relays decides whether coturn stays on this VPS.
  candidatePairType String? @map("candidate_pair_type")

  @@index([userAId])
  @@index([userBId])
  @@map("matches")
}

model Block {
  id        String   @id @default(cuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

// ---------------------------------------------------------------------------
// Calls and safety (Phase 13)
// ---------------------------------------------------------------------------

enum ReportReason {
  INAPPROPRIATE_LANGUAGE
  HARASSMENT
  NO_ENGLISH
  SEXUAL_CONTENT
  SPAM
  OTHER
}

model Report {
  id         String       @id @default(cuid())
  reporterId String       @map("reporter_id")
  reportedId String       @map("reported_id")
  matchId    String?      @map("match_id")
  reason     ReportReason
  note       String?      @db.Text
  status     String       @default("open")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([reportedId, createdAt(sort: Desc)])
  @@map("reports")
}

model PartnerRating {
  id        String   @id @default(cuid())
  matchId   String   @map("match_id")
  raterId   String   @map("rater_id")
  rateeId   String   @map("ratee_id")
  rating    Int
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([matchId, raterId])
  @@map("partner_ratings")
}

/*
 * Avatar bytes live in their own table so every User query stays light —
 * a 30-row directory page must never drag 30 images through Postgres.
 * Always stored as a 256x256 webp, re-encoded by the upload route.
 */
model Avatar {
  userId    String   @id @map("user_id")
  mime      String
  data      Bytes
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("avatars")
}
