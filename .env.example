# SpeakUp environment variables.
# Copy to .env for local development. In production, set these in Coolify.

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string.
# Local: the docker-compose Postgres below. Production: the internal
# connection string of the Coolify PostgreSQL resource.
DATABASE_URL="postgresql://speakup:speakup@localhost:5434/speakup"

# The public URL of the app. Local: http://localhost:3000.
# Production: https://your-domain.example
NEXTAUTH_URL="http://localhost:3000"

# Session signing secret, at least 32 characters.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-change-me-change-me-change-me"

# --- Optional (used from Phase 4 onward) ------------------------------------

# Anthropic API key for the AI conversation partner.
# ANTHROPIC_API_KEY=""

# OpenAI API key (alternative AI provider).
# OPENAI_API_KEY=""

# --- Realtime service (human mode) ------------------------------------------

# Public URL of the realtime (Socket.io) service, as reachable from the
# BROWSER. Local dev: the realtime dev server below. Production: the Coolify
# domain of the speakup-realtime service.
NEXT_PUBLIC_REALTIME_URL="http://localhost:4000"

# --- WebRTC / TURN (human-mode calls) ---------------------------------------

# coturn shared secret. OPTIONAL: without it the app serves STUN-only ICE
# servers, which works on most home networks and fails on symmetric NAT.
# TURN_SECRET=""

# Comma-separated TURN URLs, e.g.
# "turn:203.0.113.10:3478,turn:203.0.113.10:3478?transport=tcp"
# TURN_URLS=""

# coturn realm, if configured.
# TURN_REALM=""

# Verbose WebRTC state logging in the browser console (states only, never
# SDP or candidates). Set to "1" while debugging a call.
# NEXT_PUBLIC_RTC_DEBUG="0"

# --- Feature flags -----------------------------------------------------------

# Show AI practice mode. Optional; absent or anything but "true"/"1" hides it.
# Server-side only on purpose, so it can be flipped in Coolify without a rebuild.
# AI_MODE_ENABLED="false"
