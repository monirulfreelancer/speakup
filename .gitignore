# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env example is committed
!.env.example

# prisma generated client (built per-platform)
/src/generated/

# Compiled service worker (generated by `serwist build`)
/public/sw.js
/public/sw.js.map

# Android signing — the keystore and its passwords must never be committed
android/*.keystore
android/.keystore-pass
android/keystore.properties
android/build/
android/app/
android/gradle*
android/*.gradle
android/store_icon.png
android/manifest-checksum.txt
android/app-release-*
android/local.properties
realtime/dist/
